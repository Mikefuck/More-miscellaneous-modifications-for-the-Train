{
    "schemaVersion": 1,
    "id": "habitrain_lottery",
    "version": "${version}",
    "name": "哈比列车抽奖补齐",
    "description": "独立物品皮肤组件、抽奖、邮件、玩家资产与对局功能补齐；皮肤由扩展模组提供。",
    "authors": [
        "HabiTrain"
    ],
    "contact": {
        "homepage": "https://github.com/"
    },
    "license": "MIT",
    "icon": "assets/habitrain_lottery/icon.png",
    "environment": "*",
    "provides": [
        "habitrain_lottery_skin_api",
        "habitrain_lottery_player_api",
        "habitrain_lottery_daily_api",
        "habitrain_lottery_skin_effects"
    ],
    "entrypoints": {
        "main": [
            "com.habitrain.lottery.HabiLotteryMod"
        ],
        "client": [
            "com.habitrain.lottery.client.HabiLotteryClient"
        ],
        "modmenu": [
            "com.habitrain.lottery.client.ModMenuIntegration"
        ]
    },
    "mixins": [
        "habitrain_lottery.mixins.json",
        {
            "config": "habitrain_lottery.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.18.1",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*",
        "starrailexpress": "~4.3.0",
        "habitrain_core": ">=2.0.19"
    },
    "suggests": {
        "modmenu": "*"
    },
    "custom": {
        "habitrain_lottery:skin_api": {
            "version": 2,
            "entrypoint": "habitrain_lottery_skins"
        },
        "habitrain_lottery:skin_effects": {
            "version": 1,
            "facade": "com.habitrain.lottery.api.skin.SkinEffects"
        },
        "habitrain_lottery:player_api": {
            "version": 1,
            "facade": "com.habitrain.lottery.api.player.HabiLotteryApi"
        },
        "habitrain_lottery:daily_api": {
            "version": 1,
            "facade": "com.habitrain.lottery.api.daily.HabiDailyTaskApi"
        }
    }
}
